{
  "name": "pay-period",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pay Period: an HCM simulation for HCM Academy.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
